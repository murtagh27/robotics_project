<?xml version="1.0" ?>
<sdf version="1.4">
  <world name="default">
    <!-- Optimized physics for faster simulation -->
    <physics type='ode'>
      <gravity>0 0 -9.81</gravity>
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>20</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- A global light source -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- A ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Main tavolo (robot workbench) - robot is mounted on this at z=1.75 -->
    <include>
      <name>tavolo</name>
      <uri>model://tavolo</uri>
      <pose>0.0 0.0 0.0 0 0 0</pose>
    </include>

    <!-- Target table (where objects go) - same height as tavolo surface (0.85) -->
    <model name="target_table">
      <static>true</static>
      <pose>0.5 1.0 0.0 0 0 0</pose>
      <link name="link">
        <collision name="surface">
          <pose>0 0 0.85 0 0 0</pose>
          <geometry><box><size>0.6 0.5 0.02</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="surface_visual">
          <pose>0 0 0.85 0 0 0</pose>
          <geometry><box><size>0.6 0.5 0.02</size></box></geometry>
          <material><ambient>0.2 0.5 0.7 1</ambient><diffuse>0.2 0.5 0.7 1</diffuse></material>
        </visual>
        <collision name="leg1"><pose>0.25 0.2 0.425 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.85</length></cylinder></geometry></collision>
        <visual name="leg1_v"><pose>0.25 0.2 0.425 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.85</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material></visual>
        <collision name="leg2"><pose>-0.25 0.2 0.425 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.85</length></cylinder></geometry></collision>
        <visual name="leg2_v"><pose>-0.25 0.2 0.425 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.85</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material></visual>
        <collision name="leg3"><pose>0.25 -0.2 0.425 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.85</length></cylinder></geometry></collision>
        <visual name="leg3_v"><pose>0.25 -0.2 0.425 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.85</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material></visual>
        <collision name="leg4"><pose>-0.25 -0.2 0.425 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.85</length></cylinder></geometry></collision>
        <visual name="leg4_v"><pose>-0.25 -0.2 0.425 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.85</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material></visual>
      </link>
    </model>

    <!-- RGB-D Camera fixed above workspace -->
    <model name="rgbd_camera">
      <static>true</static>
      <!-- Position: between source (tavolo) and target table, looking down -->
      <pose>0.5 0.65 1.7 0 1.57 0</pose>
      
      <link name="camera_link">
        <!-- Visual representation of camera-->
        <!-- Camera body -->
        <visual name="body">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.08</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        
        <!-- Camera lens -->
        <visual name="lens">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>0.005</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.3 0.0 0.0 1</ambient>
            <diffuse>0.5 0.0 0.0 1</diffuse>
          </material>
        </visual>


        <!-- Camera sensor with RGB-D capability -->
        <sensor name="camera" type="depth">
          <update_rate>30</update_rate>
          <camera>
            <horizontal_fov>1.396</horizontal_fov>  <!-- 80 degrees -->
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>5.0</far>
            </clip>
          </camera>
          
          <!-- Gazebo ROS plugin for RGB-D -->
          <plugin name="camera_controller" filename="libgazebo_ros_openni_kinect.so">
            <baseline>0.2</baseline>
            <alwaysOn>true</alwaysOn>
            <updateRate>30.0</updateRate>
            <cameraName>camera</cameraName>
            <imageTopicName>rgb/image_raw</imageTopicName>
            <cameraInfoTopicName>rgb/camera_info</cameraInfoTopicName>
            <depthImageTopicName>depth/image_raw</depthImageTopicName>
            <depthImageCameraInfoTopicName>depth/camera_info</depthImageCameraInfoTopicName>
            <pointCloudTopicName>depth/points</pointCloudTopicName>
            <frameName>camera_optical_frame</frameName>
            <distortionK1>0.0</distortionK1>
            <distortionK2>0.0</distortionK2>
            <distortionK3>0.0</distortionK3>
            <distortionT1>0.0</distortionT1>
            <distortionT2>0.0</distortionT2>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- Camera view -->
    <gui>
      <camera name="gzclient_camera">
        <pose>1.5 2.0 2.0 0 0.4 -2.0</pose>
      </camera>
    </gui>

  </world>
</sdf>
