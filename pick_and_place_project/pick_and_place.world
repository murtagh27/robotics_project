<?xml version="1.0" ?>
<sdf version="1.4">
  <world name="default">
    <!-- Optimized physics for faster simulation -->
    <physics type='ode'>
      <gravity>0 0 -9.81</gravity>
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>20</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- A global light source -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- A ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Main tavolo (robot workbench) - robot is mounted on this at z=1.75 -->
    <include>
      <name>tavolo</name>
      <uri>model://tavolo</uri>
      <pose>0.0 0.0 0.0 0 0 0</pose>
    </include>

    <!-- Target table (where objects go) - same height as tavolo surface (0.85) -->
    <model name="target_table">
      <static>true</static>
      <pose>0.5 1.0 0.0 0 0 0</pose>
      <link name="link">
        <collision name="surface">
          <pose>0 0 0.85 0 0 0</pose>
          <geometry><box><size>0.6 0.5 0.02</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="surface_visual">
          <pose>0 0 0.85 0 0 0</pose>
          <geometry><box><size>0.6 0.5 0.02</size></box></geometry>
          <material><ambient>0.2 0.5 0.7 1</ambient><diffuse>0.2 0.5 0.7 1</diffuse></material>
        </visual>
        <collision name="leg1"><pose>0.25 0.2 0.425 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.85</length></cylinder></geometry></collision>
        <visual name="leg1_v"><pose>0.25 0.2 0.425 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.85</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material></visual>
        <collision name="leg2"><pose>-0.25 0.2 0.425 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.85</length></cylinder></geometry></collision>
        <visual name="leg2_v"><pose>-0.25 0.2 0.425 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.85</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material></visual>
        <collision name="leg3"><pose>0.25 -0.2 0.425 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.85</length></cylinder></geometry></collision>
        <visual name="leg3_v"><pose>0.25 -0.2 0.425 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.85</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material></visual>
        <collision name="leg4"><pose>-0.25 -0.2 0.425 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.85</length></cylinder></geometry></collision>
        <visual name="leg4_v"><pose>-0.25 -0.2 0.425 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.85</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material></visual>
      </link>
    </model>

    <!-- Red cube on tavolo (surface at z=0.85, cube center at 0.875) -->
    <model name="cube_red">
      <pose>0.35 0.5 0.90 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.1</mass>
          <inertia><ixx>0.000041</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.000041</iyy><iyz>0</iyz><izz>0.000041</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Green cube -->
    <model name="cube_green">
      <pose>0.50 0.5 0.90 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.1</mass>
          <inertia><ixx>0.000041</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.000041</iyy><iyz>0</iyz><izz>0.000041</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Blue cube -->
    <model name="cube_blue">
      <pose>0.65 0.5 0.90 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.1</mass>
          <inertia><ixx>0.000041</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.000041</iyy><iyz>0</iyz><izz>0.000041</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Yellow cylinder -->
    <model name="cylinder_yellow">
      <pose>0.50 0.65 0.90 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.1</mass>
          <inertia><ixx>0.000045</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.000045</iyy><iyz>0</iyz><izz>0.000031</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.025</radius><length>0.06</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.025</radius><length>0.06</length></cylinder></geometry>
          <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Camera view -->
    <gui>
      <camera name="gzclient_camera">
        <pose>1.5 2.0 2.0 0 0.4 -2.0</pose>
      </camera>
    </gui>

  </world>
</sdf>
