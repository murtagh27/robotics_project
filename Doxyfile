# Doxyfile for PAPA Project

#---------------------------------------------------------------------------
# Project related configuration options
#---------------------------------------------------------------------------
DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "PAPA - Pick and Place Project"
PROJECT_NUMBER         = "v1.0"
PROJECT_BRIEF          = "Robotic pick and place system with YOLO-based perception"
OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

#---------------------------------------------------------------------------
# Build related configuration options
